<link rel="stylesheet" href="../style.css">
</head>
<body>

<nav class="navbar">
  <div class="wrap">
    <a href="index.html" class="nav-logo">EMBER XIONG</a>
    <div class="nav-right">
      <div class="nav-links">
        <a href="about.html">About</a>
        <a href="services.html">Services</a>
